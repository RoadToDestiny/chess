# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments
venv/
.venv/
env/
ENV/
.env

# IDE and editors
.vscode/
.idea/
*.swp
*.swo

# Binary executables
bin/*.exe
bin/*.zip

# Project Data (raw PGNs and large processed tables)
data/raw/*.pgn
!data/raw/filtered_games.pgn
data/raw/*.zst
data/raw/*.gz
data/interim/*
!data/interim/labeled_sample.csv
data/processed/*.csv
!data/processed/final_dataset.csv
data/processed/*.parquet
data/splits/*.csv
!data/splits/train.csv
!data/splits/val.csv
!data/splits/test.csv
!data/splits/*_game_ids.csv

# Artifacts & Model weights
artifacts/models/*.ubj
!artifacts/models/model.json
!artifacts/models/model_metadata.json
!artifacts/runs/main_run.json

# Documentation / personal notes
/!info/

# Pytest / coverage
